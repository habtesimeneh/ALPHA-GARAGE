# =====================================================================
# AutoPro Garage Management System — Environment Configuration
# Reference only: PHP does not load this file automatically. Configure runtime variables separately.
# =====================================================================

# Application Environment
GMS_NAME="Alpha Garage"
GMS_DEBUG=false
GMS_TIMEZONE="Africa/Addis_Ababa"

# Absolute public base URL used in password-reset e-mail links.
# Production value must be https, with no trailing slash.
GMS_APP_URL=https://garage.example.com

# Outbound mail (required for real password-reset delivery).
# Without these values the application only writes to storage/mail_spool and
# reports delivery as failed; it never claims an e-mail was sent.
# Use a sender on a domain that publishes SPF, DKIM and DMARC.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=alerts@garage.example.com
SMTP_PASSWORD=replace-with-the-smtp-password
SMTP_FROM_EMAIL=no-reply@garage.example.com
SMTP_FROM_NAME="Alpha Garage"
SMTP_ENCRYPTION=tls

# Database connection. Create dedicated, non-root users; do not use development root credentials.
GMS_DB_HOST=127.0.0.1
GMS_DB_PORT=3306
GMS_DB_NAME=garage_management_system
GMS_DB_USER=garage_app
GMS_DB_PASS=replace-with-a-long-random-application-password

# Used only by the CLI migration command; do not grant this account to the web runtime.
GMS_MIGRATION_DB_USER=garage_migrator
GMS_MIGRATION_DB_PASS=replace-with-a-different-long-random-migration-password
GMS_DB_TZ=+03:00

# Security & Master Encryption Key (32-byte key for AES-256-GCM)
# If left empty, a secure key is auto-generated in storage/private/encryption.key
# GMS_ENCRYPTION_KEY=64-hexadecimal-characters-for-32-random-bytes

# Session Settings
GMS_SESSION_LIFETIME=1800
GMS_LOCKOUT_MINUTES=15
